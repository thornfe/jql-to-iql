{
  "name": "@thornfe/jql2iql",
  "version": "0.0.3",
  "description": "A Translator That Converts Jira JQL into Gitee IQL",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown",
    "benchmark": "tsx benchmark/index.ts",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thornfe/jql-to-iql.git"
  },
  "keywords": [
    "jql",
    "iql",
    "jira",
    "gitee",
    "query",
    "translator",
    "converter",
    "parser"
  ],
  "author": "thornfe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thornfe/jql-to-iql/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@atlaskit/jql-parser": "^2.0.1",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "antlr4ts": "0.5.0-alpha.4",
    "eslint": "^9.39.2",
    "ts-node": "^10.9.2",
    "tsdown": "0.20.0-beta.3",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.17"
  },
  "homepage": "https://github.com/thornfe/jql-to-iql#readme"
}
